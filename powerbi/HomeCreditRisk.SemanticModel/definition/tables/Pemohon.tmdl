table Pemohon
	lineageTag: d7d48904-b055-42e0-8f92-ee7cc3ee7e77

	/// Batas approve dari slicer (default hasil NB 04)
	measure 'Batas Approve Aktif' = SELECTEDVALUE('Batas Approve'[Batas Approve], 12) / 100
		formatString: 0.0%
		displayFolder: 0 Parameter
		lineageTag: 8c0b2a68-b0b8-47d8-937e-b3c9e6b44c4b

	/// Batas reject dari slicer, minimal sama dengan batas approve
	measure 'Batas Reject Aktif' = MAX(SELECTEDVALUE('Batas Reject'[Batas Reject], 22) / 100, [Batas Approve Aktif])
		formatString: 0.0%
		displayFolder: 0 Parameter
		lineageTag: caef23e5-b0cc-4ff6-ae7d-0f5d188da9c7

	/// Loss Given Default dari slicer (default 45%)
	measure 'LGD Aktif' = SELECTEDVALUE('LGD'[LGD], 45) / 100
		formatString: 0%
		displayFolder: 0 Parameter
		lineageTag: e8f9c9df-f69a-4a76-9efa-8a04a48105ab

	/// Porsi limit yang tetap diberikan di zona Review. 0% = Review ditolak
	measure 'Limit Review Aktif' = SELECTEDVALUE('Limit Review'[Limit Review], 0) / 100
		formatString: 0%
		displayFolder: 0 Parameter
		lineageTag: 7a0a7220-e570-42aa-9076-439b9488cc7d

	/// Jumlah pemohon
	measure 'Jumlah Pemohon' = COUNTROWS(Pemohon)
		formatString: #,0
		displayFolder: 1 Portofolio
		lineageTag: 9d1b624a-0e81-41a7-8195-08840c590eed

	/// Jumlah pemohon yang gagal bayar
	measure 'Jumlah Gagal Bayar' = SUM(Pemohon[TARGET])
		formatString: #,0
		displayFolder: 1 Portofolio
		lineageTag: fb3f2dc7-33eb-4fc9-8427-5366a22860f9

	/// Persentase gagal bayar
	measure 'Default Rate' = DIVIDE([Jumlah Gagal Bayar], [Jumlah Pemohon])
		formatString: 0.0%
		displayFolder: 1 Portofolio
		lineageTag: 47c70242-d9f4-47ae-9f26-9d4e9bfbbfad

	/// Rata-rata probabilitas gagal bayar dari model
	measure 'Rata-rata PD' = AVERAGE(Pemohon[PD])
		formatString: 0.0%
		displayFolder: 1 Portofolio
		lineageTag: 05c7ef81-552a-4984-b027-fff5545fac55

	/// Total nilai pinjaman
	measure 'Total Pinjaman' = SUM(Pemohon[AMT_CREDIT]) / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 1 Portofolio
		lineageTag: 3e0adfb8-8dde-428d-9066-5720b806b994

	/// Porsi pemohon terhadap seluruh pemohon (mengikuti slicer lain)
	measure 'Porsi Pemohon' = DIVIDE([Jumlah Pemohon], CALCULATE([Jumlah Pemohon], ALLSELECTED(Pemohon[ZONA])))
		formatString: 0.0%
		displayFolder: 1 Portofolio
		lineageTag: 5542012b-3885-423d-9692-eca0d3f96048

	/// Porsi gagal bayar segmen ini dari seluruh gagal bayar
	measure 'Porsi Gagal Bayar' = DIVIDE([Jumlah Gagal Bayar], CALCULATE([Jumlah Gagal Bayar], ALLSELECTED(Pemohon[ZONA])))
		formatString: 0.0%
		displayFolder: 1 Portofolio
		lineageTag: 8499a1dd-1767-42c8-b8da-a1419c4bc4af

	/// Pinjaman gagal bayar x LGD (sebelum tindakan)
	measure 'Potensi Kerugian' = CALCULATE(SUM(Pemohon[AMT_CREDIT]), Pemohon[TARGET] = 1) * [LGD Aktif] / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 1 Portofolio
		lineageTag: d11c62c0-172a-47f1-8bee-5fe48d302a81

	/// Kerugian jika semua pengajuan disetujui: pinjaman gagal bayar x LGD
	measure 'Expected Loss Tanpa Model' = [Potensi Kerugian]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: 0923c941-bfcb-4ef1-aae9-08318944a132

	/// Kerugian dari gagal bayar yang tetap disetujui (zona Review mengikuti porsi limit)
	measure 'Expected Loss Dengan Model' =
			VAR ta = [Batas Approve Aktif]
			VAR tr = [Batas Reject Aktif]
			VAR k = [Limit Review Aktif]
			VAR lgd = [LGD Aktif]
			RETURN
			    SUMX(
			        FILTER(Pemohon, Pemohon[TARGET] = 1 && Pemohon[PD] < tr),
			        Pemohon[AMT_CREDIT] * lgd * IF(Pemohon[PD] < ta, 1, k)
			    ) / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: 280c2871-7060-4364-9ecb-a9bbe3278c9f

	/// Margin yang hilang dari nasabah baik yang ditolak atau limitnya dipotong
	measure 'Keuntungan Hilang' =
			VAR ta = [Batas Approve Aktif]
			VAR tr = [Batas Reject Aktif]
			VAR k = [Limit Review Aktif]
			VAR lgd = [LGD Aktif]
			RETURN
			    SUMX(
			        FILTER(Pemohon, Pemohon[TARGET] = 0 && Pemohon[PD] >= ta),
			        Pemohon[KEUNTUNGAN_POTENSIAL] * IF(Pemohon[PD] >= tr, 1, 1 - k)
			    ) / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: 43846f7e-bbb7-462e-8aed-55f512a455ac

	/// Expected loss + keuntungan hilang
	measure 'Total Biaya Dengan Model' = [Expected Loss Dengan Model] + [Keuntungan Hilang]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: cf27e7a5-2503-477f-a98c-e39e74096a4e

	/// Selisih expected loss tanpa dan dengan model
	measure 'Expected Loss Dicegah' = [Expected Loss Tanpa Model] - [Expected Loss Dengan Model]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: 6c96a22e-877d-4871-8870-e2a8a70b3461

	/// Persentase expected loss yang dicegah
	measure 'Expected Loss Turun %' = DIVIDE([Expected Loss Dicegah], [Expected Loss Tanpa Model])
		formatString: 0.0%
		displayFolder: 2 Kebijakan
		lineageTag: 00e29e8b-40df-4a87-8e22-e481728b589d

	/// Total biaya tanpa model dikurangi total biaya dengan model
	measure 'Penghematan Bersih' = [Expected Loss Tanpa Model] - [Total Biaya Dengan Model]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 2 Kebijakan
		lineageTag: c6cc0aef-4e20-4d4d-bdad-13d9a085bae4

	/// Penghematan bersih dibanding total biaya tanpa model
	measure 'Penghematan Bersih %' = DIVIDE([Penghematan Bersih], [Expected Loss Tanpa Model])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Kebijakan
		lineageTag: d6e4e211-cf9b-4a9e-9127-027aefe3fdfa

	/// Penghematan bersih dibagi jumlah pemohon x 1.000
	measure 'Penghematan per 1.000 Pemohon' = DIVIDE([Penghematan Bersih] * 1e9, [Jumlah Pemohon]) * 1000
		formatString: #,0
		displayFolder: 2 Kebijakan
		lineageTag: 3ddd09af-4d14-427a-8396-977d91f59ea2

	/// Approve + Review (jika limit Review > 0%)
	measure 'Pemohon Disetujui' =
			VAR ta = [Batas Approve Aktif]
			VAR tr = [Batas Reject Aktif]
			VAR k = [Limit Review Aktif]
			VAR lgd = [LGD Aktif]
			RETURN
			    COUNTROWS(FILTER(Pemohon, Pemohon[PD] < ta || (k > 0 && Pemohon[PD] < tr)))
		formatString: #,0
		displayFolder: 2 Kebijakan
		lineageTag: 72a9cf88-bfb2-4163-ab27-d9276e95fbd7

	/// Approval rate
	measure 'Persen Disetujui' = DIVIDE([Pemohon Disetujui], [Jumlah Pemohon])
		formatString: 0.0%
		displayFolder: 2 Kebijakan
		lineageTag: 3e64b947-79cc-4b16-80e0-929177286751

	/// Default rate di antara pinjaman yang disetujui
	measure 'Default Rate Disetujui' =
			VAR ta = [Batas Approve Aktif]
			VAR tr = [Batas Reject Aktif]
			VAR k = [Limit Review Aktif]
			VAR lgd = [LGD Aktif]
			RETURN
			    DIVIDE(
			        COUNTROWS(FILTER(Pemohon, Pemohon[TARGET] = 1 && (Pemohon[PD] < ta || (k > 0 && Pemohon[PD] < tr)))),
			        [Pemohon Disetujui]
			    )
		formatString: 0.00%
		displayFolder: 2 Kebijakan
		lineageTag: 98c93350-e6b7-4a3b-a9ec-d8854bdcd24d

	/// Gagal bayar dengan PD >= batas approve
	measure 'Gagal Bayar Tertangkap' =
			VAR ta = [Batas Approve Aktif]
			RETURN COUNTROWS(FILTER(Pemohon, Pemohon[TARGET] = 1 && Pemohon[PD] >= ta))
		formatString: #,0
		displayFolder: 2 Kebijakan
		lineageTag: ac2c9fa0-2592-48de-b72a-7aa1188996cb

	/// Persentase gagal bayar yang tertangkap model
	measure Recall = DIVIDE([Gagal Bayar Tertangkap], [Jumlah Gagal Bayar])
		formatString: 0.0%
		displayFolder: 2 Kebijakan
		lineageTag: b9d681b3-03e7-4073-8635-1f1531cf1fa6

	/// Persentase tolakan yang memang gagal bayar
	measure Precision =
			VAR ta = [Batas Approve Aktif]
			RETURN DIVIDE([Gagal Bayar Tertangkap], COUNTROWS(FILTER(Pemohon, Pemohon[PD] >= ta)))
		formatString: 0.0%
		displayFolder: 2 Kebijakan
		lineageTag: 1ca440ba-670a-4455-87b7-d26c36ced60c

	/// F2 pada batas approve aktif (recall diberi bobot 4x precision)
	measure 'F2 Score' =
			VAR p = [Precision]
			VAR r = [Recall]
			RETURN DIVIDE(5 * p * r, 4 * p + r)
		formatString: 0.000
		displayFolder: 2 Kebijakan
		lineageTag: a28087db-30f9-4edd-891c-5aea2e59a560

	/// Expected loss per skenario
	measure 'Expected Loss Skenario' = SWITCH(SELECTEDVALUE(Skenario[Skenario]), "Tanpa model", [Expected Loss Tanpa Model], "Dengan model", [Expected Loss Dengan Model])
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 0d618fe8-64e7-47ae-bf93-1645bb7871e2

	/// Keuntungan hilang per skenario
	measure 'Keuntungan Hilang Skenario' = IF(SELECTEDVALUE(Skenario[Skenario]) = "Dengan model", [Keuntungan Hilang], 0)
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: da31a1f5-1de6-437e-95c1-301083607559

	/// Expected loss jika tolak semua PD >= threshold pada sumbu X
	measure 'Expected Loss Kurva' =
			VAR t = SELECTEDVALUE('Kurva Threshold'[Threshold])
			VAR lgd = [LGD Aktif]
			RETURN SUMX(FILTER(Pemohon, Pemohon[TARGET] = 1 && Pemohon[PD] < t), Pemohon[AMT_CREDIT]) * lgd / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 5fc6c33d-ada4-4163-bf49-428468b28190

	/// Keuntungan hilang jika tolak semua PD >= threshold pada sumbu X
	measure 'Keuntungan Hilang Kurva' =
			VAR t = SELECTEDVALUE('Kurva Threshold'[Threshold])
			RETURN SUMX(FILTER(Pemohon, Pemohon[TARGET] = 0 && Pemohon[PD] >= t), Pemohon[KEUNTUNGAN_POTENSIAL]) / 1e9
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 36e4b67d-c513-41f6-9d16-2141065e0f90

	/// Expected loss + keuntungan hilang per threshold
	measure 'Total Biaya Kurva' = [Expected Loss Kurva] + [Keuntungan Hilang Kurva]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 26a9d30a-149f-47a9-940f-b791872c5f55

	/// Garis pembanding: total biaya tanpa model
	measure 'Total Biaya Tanpa Model' = CALCULATE([Expected Loss Tanpa Model], ALL('Kurva Threshold'))
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 7ce8abaa-a94b-4070-819c-d6839f926bcd

	/// Ringkasan kebijakan aktif untuk subjudul
	measure 'Judul Dinamis' = "Batas approve " & FORMAT([Batas Approve Aktif], "0.0%") & " | batas reject " & FORMAT([Batas Reject Aktif], "0.0%") & " | LGD " & FORMAT([LGD Aktif], "0%") & " | limit di zona Review " & FORMAT([Limit Review Aktif], "0%")
		displayFolder: 3 Grafik
		lineageTag: 3c1a7070-efc4-4c06-8b0f-a54e743f5e73

	/// Hijau jika penghematan >= 0, merah jika negatif
	measure 'Warna Positif Hijau' = IF([Penghematan Bersih] >= 0, "#4E8F69", "#C0504A")
		displayFolder: 4 Format
		lineageTag: bf20665d-cf1b-465d-9df5-3787ae0b17c4

	/// Hijau jika default rate disetujui di bawah default rate tanpa model
	measure 'Warna Default Rate' = IF([Default Rate Disetujui] <= [Default Rate], "#4E8F69", "#C0504A")
		displayFolder: 4 Format
		lineageTag: 20bec556-393e-4d6c-9e01-d5e6871de605

	/// Warna angka netral
	measure 'Warna Netral' = "#3A4149"
		displayFolder: 4 Format
		lineageTag: 580473bd-fbe5-4156-b8a9-1f639fb6cf34

	/// Hijau jika ada kerugian yang dicegah
	measure 'Warna Dicegah' = IF([Expected Loss Dicegah] > 0, "#4E8F69", "#C0504A")
		displayFolder: 4 Format
		lineageTag: 0dd2253b-bb3c-482b-8f28-9f3e55ce2a82

	/// Teks pembanding
	measure 'Sub EL Tanpa' = "semua disetujui | LGD " & FORMAT([LGD Aktif], "0%")
		displayFolder: 4 Format
		lineageTag: a4af0026-e1c0-4a33-ba8c-e6c1e477509d

	/// Teks pembanding
	measure 'Sub EL Dengan' = "-" & FORMAT([Expected Loss Turun %], "0.0%") & " vs tanpa model"
		displayFolder: 4 Format
		lineageTag: 2f859a76-989b-45df-ae5b-2ca69419ee84

	/// Teks pembanding
	measure 'Sub Dicegah' = FORMAT([Gagal Bayar Tertangkap], "#,0") & " gagal bayar tertangkap"
		displayFolder: 4 Format
		lineageTag: 141a3d36-ffad-4b2d-8bcc-ab7e99dfff89

	/// Teks pembanding
	measure 'Sub Hilang' = "margin nasabah baik ditolak"
		displayFolder: 4 Format
		lineageTag: 5971523d-a46f-4a79-ae7c-9657882d97bd

	/// Teks pembanding
	measure 'Sub Hemat' = FORMAT([Penghematan Bersih %], "+0.0%;-0.0%") & " vs tanpa model"
		displayFolder: 4 Format
		lineageTag: 72475fe4-d878-4b32-bf94-1defa9ca63a6

	/// Teks pembanding
	measure 'Sub DR' = "sebelumnya " & FORMAT([Default Rate], "0.00%")
		displayFolder: 4 Format
		lineageTag: 22a3c4f8-2a5d-475f-ae55-43fd5417c026

	/// Teks pembanding
	measure 'Sub F2' = "recall " & FORMAT([Recall], "0%") & " | prec " & FORMAT([Precision], "0%")
		displayFolder: 4 Format
		lineageTag: 740c033c-4b8e-4bee-80ef-4fbe5ef012c1

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Desil' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[DESIL_SKOR_EKSTERNAL]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: 7aa1e430-3d0e-4fb7-9831-bdfa037fe972

	/// Teks sorotan dinamis
	measure 'Info Sorot Desil' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[DESIL_SKOR_EKSTERNAL]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[DESIL_SKOR_EKSTERNAL]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[DESIL_SKOR_EKSTERNAL]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: 7952e042-0058-45bb-92d9-de7ba9504a40

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Usia' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[KELOMPOK_USIA]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: 7671e88d-acf7-4c49-9f8b-02b0fc186908

	/// Teks sorotan dinamis
	measure 'Info Sorot Usia' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[KELOMPOK_USIA]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[KELOMPOK_USIA]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[KELOMPOK_USIA]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: 889d8176-26a0-4813-b933-35b69d7d9bc5

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Pendidikan' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[PENDIDIKAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: 6d2b6313-adce-4ec8-a688-bf7a2e0c4f21

	/// Teks sorotan dinamis
	measure 'Info Sorot Pendidikan' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[PENDIDIKAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[PENDIDIKAN]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[PENDIDIKAN]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: e4d2cd50-0262-4b9a-abcf-b411222de8e7

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Wilayah' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[RATING_WILAYAH]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: e3ee33b0-1c2c-42cf-84fe-9e09cf4755e6

	/// Teks sorotan dinamis
	measure 'Info Sorot Wilayah' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[RATING_WILAYAH]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[RATING_WILAYAH]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[RATING_WILAYAH]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: 8ebca0a4-7880-409d-bea8-be661f641e99

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Pekerjaan' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[PEKERJAAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: dba7f458-8c5e-4f71-ac32-275ab4dc8ea3

	/// Teks sorotan dinamis
	measure 'Info Sorot Pekerjaan' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[PEKERJAAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[PEKERJAAN]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[PEKERJAAN]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: 6a5a7938-af62-4a67-aab8-b95087415b7e

	/// Merah = default rate tertinggi, hijau = terendah (ikut filter)
	measure 'Warna Sorot Pendapatan' =
			VAR cur = [Default Rate]
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[SUMBER_PENDAPATAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			RETURN SWITCH(TRUE(), cur = MAXX(t, [@dr]), "#C8574F", cur = MINX(t, [@dr]), "#5E9E78", "#C5CCD4")
		displayFolder: 4 Format
		lineageTag: 340bc5a8-c5d0-4927-a103-0331ba0efb40

	/// Teks sorotan dinamis
	measure 'Info Sorot Pendapatan' =
			VAR t = FILTER(ADDCOLUMNS(ALLSELECTED(Pemohon[SUMBER_PENDAPATAN]), "@dr", [Default Rate], "@n", [Jumlah Pemohon]), [@n] >= 100)
			VAR hi = TOPN(1, t, [@dr], DESC)
			VAR lo = TOPN(1, t, [@dr], ASC)
			RETURN "Merah tertinggi: " & MAXX(hi, Pemohon[SUMBER_PENDAPATAN]) & " (" & FORMAT(MAXX(hi, [@dr]), "0.0%") & ")  |  hijau terendah: " & MAXX(lo, Pemohon[SUMBER_PENDAPATAN]) & " (" & FORMAT(MAXX(lo, [@dr]), "0.0%") & ")"
		displayFolder: 4 Format
		lineageTag: a325ef5e-50ca-4d9d-a191-58bab870a5df

	/// Teks pembanding dinamis
	measure 'Banding EL Tanpa' = FORMAT([Jumlah Gagal Bayar], "#,0") & " gagal bayar x LGD " & FORMAT([LGD Aktif], "0%")
		displayFolder: 5 Pembanding
		lineageTag: 02ac09e5-1822-4245-8fc2-a7587595ad06

	/// Warna pembanding
	measure 'Warna Banding EL Tanpa' = "#6E7781"
		displayFolder: 5 Pembanding
		lineageTag: a41800e3-5db4-43ca-9f21-6cd107617737

	/// Teks pembanding dinamis
	measure 'Banding EL Dengan' = "▼ " & FORMAT([Expected Loss Turun %], "0.0%") & " vs tanpa model"
		displayFolder: 5 Pembanding
		lineageTag: 0f1b1c1d-9795-43bd-984c-af94d411df29

	/// Warna pembanding
	measure 'Warna Banding EL Dengan' = IF([Expected Loss Turun %] > 0, "#4E8F69", "#C0504A")
		displayFolder: 5 Pembanding
		lineageTag: 8d3f3d71-8598-4f62-89ad-269bb4993484

	/// Teks pembanding dinamis
	measure 'Banding Dicegah' = "▲ " & FORMAT([Recall], "0%") & " gagal bayar tertangkap"
		displayFolder: 5 Pembanding
		lineageTag: d3633dc5-55e4-42fb-9737-e793a0d89497

	/// Warna pembanding
	measure 'Warna Banding Dicegah' = IF([Expected Loss Dicegah] > 0, "#4E8F69", "#C0504A")
		displayFolder: 5 Pembanding
		lineageTag: a3dbb948-da09-403e-8e59-ebd6c080702f

	/// Teks pembanding dinamis
	measure 'Banding Hilang' = FORMAT(DIVIDE([Keuntungan Hilang], [Expected Loss Tanpa Model]), "0%") & " dari kerugian awal"
		displayFolder: 5 Pembanding
		lineageTag: 43d557f2-c362-4f68-aa6b-ad45e2ba5dd7

	/// Warna pembanding
	measure 'Warna Banding Hilang' = "#B7862F"
		displayFolder: 5 Pembanding
		lineageTag: 2e24775b-1bde-4bf7-a897-3510d9fd4569

	/// Teks pembanding dinamis
	measure 'Banding Hemat' = IF([Penghematan Bersih] >= 0, "▲ ", "▼ ") & FORMAT(ABS([Penghematan Bersih %]), "0.0%") & " vs tanpa model"
		displayFolder: 5 Pembanding
		lineageTag: 57755e83-69fe-42e4-aeeb-dcfe88a6e5b7

	/// Warna pembanding
	measure 'Warna Banding Hemat' = IF([Penghematan Bersih] >= 0, "#4E8F69", "#C0504A")
		displayFolder: 5 Pembanding
		lineageTag: fcdf91b9-be88-4f5d-9a18-dbecc8e4f69e

	/// Teks pembanding dinamis
	measure 'Banding DR' = "▼ " & FORMAT(([Default Rate] - [Default Rate Disetujui]) * 100, "0.0") & " poin dari " & FORMAT([Default Rate], "0.0%")
		displayFolder: 5 Pembanding
		lineageTag: 856de54f-2a9f-47c2-9710-fff5cd7f31b1

	/// Warna pembanding
	measure 'Warna Banding DR' = IF([Default Rate Disetujui] <= [Default Rate], "#4E8F69", "#C0504A")
		displayFolder: 5 Pembanding
		lineageTag: 772e4397-8277-440e-adc0-e70005225911

	/// Teks pembanding dinamis
	measure 'Banding F2' =
			VAR p = [Default Rate]
			VAR b = DIVIDE(5 * p, 4 * p + 1)
			RETURN IF([F2 Score] >= b, "▲ +", "▼ ") & FORMAT([F2 Score] - b, "0.000") & " vs tanpa model"
		displayFolder: 5 Pembanding
		lineageTag: 69c7237f-f46a-462e-8e95-950039707650

	/// Warna pembanding
	measure 'Warna Banding F2' =
			VAR p = [Default Rate]
			RETURN IF([F2 Score] >= DIVIDE(5 * p, 4 * p + 1), "#4E8F69", "#C0504A")
		displayFolder: 5 Pembanding
		lineageTag: b21e57f6-6b01-45c2-b79f-6cd8fada794e

	/// Teks pembanding dinamis
	measure 'Banding Pemohon' = FORMAT(DIVIDE([Jumlah Pemohon], CALCULATE([Jumlah Pemohon], ALL(Pemohon))), "0%") & " dari seluruh pemohon"
		displayFolder: 5 Pembanding
		lineageTag: da10c052-4d48-43b0-af46-6791f3b76ea4

	/// Warna pembanding
	measure 'Warna Banding Pemohon' = "#6E7781"
		displayFolder: 5 Pembanding
		lineageTag: 172cd037-9286-4217-bc09-3ab5da3ddc93

	/// Teks pembanding dinamis
	measure 'Banding Default Rate' =
			VAR d = [Default Rate] - CALCULATE([Default Rate], ALL(Pemohon))
			RETURN IF(d > 0, "▲ +", "▼ ") & FORMAT(d * 100, "0.0") & " poin vs rata-rata"
		displayFolder: 5 Pembanding
		lineageTag: f793e75d-c178-4f13-b02d-89f2ae43516f

	/// Warna pembanding
	measure 'Warna Banding Default Rate' = IF([Default Rate] > CALCULATE([Default Rate], ALL(Pemohon)), "#C0504A", "#4E8F69")
		displayFolder: 5 Pembanding
		lineageTag: ee494694-a5d8-48c3-b4e7-86b284d63be2

	/// Teks pembanding dinamis
	measure 'Banding PD' = "selisih " & FORMAT(ABS([Rata-rata PD] - [Default Rate]) * 100, "0.0") & " poin dari aktual"
		displayFolder: 5 Pembanding
		lineageTag: c8b6b55e-2205-4160-ba91-869a7b8d595c

	/// Warna pembanding
	measure 'Warna Banding PD' = IF(ABS([Rata-rata PD] - [Default Rate]) < 0.01, "#4E8F69", "#B7862F")
		displayFolder: 5 Pembanding
		lineageTag: 059c1dac-0349-406b-9852-7dfa8d7aed66

	/// Teks pembanding dinamis
	measure 'Banding Pinjaman' = FORMAT(DIVIDE([Total Pinjaman], CALCULATE([Total Pinjaman], ALL(Pemohon))), "0%") & " dari total pinjaman"
		displayFolder: 5 Pembanding
		lineageTag: 60c387fe-b1fa-4d16-a76a-63982bff50b4

	/// Warna pembanding
	measure 'Warna Banding Pinjaman' = "#6E7781"
		displayFolder: 5 Pembanding
		lineageTag: be465377-2d0b-4269-94ff-6cff0b9f9dda

	/// Teks pembanding dinamis
	measure 'Banding Potensi' = FORMAT(DIVIDE([Potensi Kerugian], CALCULATE([Potensi Kerugian], ALL(Pemohon))), "0%") & " dari total potensi kerugian"
		displayFolder: 5 Pembanding
		lineageTag: 716c4d97-b4bf-4626-bb0d-ec072498b5c5

	/// Warna pembanding
	measure 'Warna Banding Potensi' = "#6E7781"
		displayFolder: 5 Pembanding
		lineageTag: 5ad27c80-2c17-4f78-8221-602fb1c0607a

	/// Expected loss yang masih terjadi (untuk grafik per segmen)
	measure 'Expected Loss Tersisa' = [Expected Loss Dengan Model]
		formatString: #,0.00" M";-#,0.00" M"
		displayFolder: 3 Grafik
		lineageTag: 6b5385ea-6e79-42b4-a384-fd9809e33ca1

