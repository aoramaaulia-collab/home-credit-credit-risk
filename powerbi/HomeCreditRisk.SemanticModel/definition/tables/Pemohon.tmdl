	partition Pemohon = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pemohon_test.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Header, {{"SK_ID_CURR", Int64.Type}, {"TARGET", Int64.Type}, {"PD", type number}, {"AMT_CREDIT", type number}, {"AMT_ANNUITY", type number}, {"AMT_INCOME_TOTAL", type number}, {"TENOR_BULAN", type number}, {"KEUNTUNGAN_POTENSIAL", type number}, {"JENIS_KONTRAK", type text}, {"DESIL_SKOR_EKSTERNAL", type text}, {"KELOMPOK_USIA", type text}, {"SUMBER_PENDAPATAN", type text}, {"PENDIDIKAN", type text}, {"RATING_WILAYAH", type text}, {"PEKERJAAN", type text}, {"ZONA", type text}, {"ZONA_URUT", Int64.Type}, {"DESIL_URUT", Int64.Type}, {"USIA_URUT", Int64.Type}, {"PENDIDIKAN_URUT", Int64.Type}, {"STATUS", type text}}, "en-US")
				in
				    Typed

